@model IEnumerable<OnlineMovieBooking.Models.Movie>

@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as List<OnlineMovieBooking.Models.MovieCategory>;
}

<main>
    <div class="p-4 mb-4 bg-light rounded-3 mt-3">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold">Online Movie Booking</h1>
            <p class="col-md-8 fs-5">Welcome to the Online Movie Booking System. Browse movies, view categories, and easily book your movie tickets.</p>
            <p>
                @Html.ActionLink("Book Tickets", "Book", "Booking", null, new { @class = "btn btn-primary btn-lg" })
                @Html.ActionLink("View Movies", "Index", "Movie", null, new { @class = "btn btn-outline-secondary btn-lg" })
            </p>
        </div>
    </div>

    <!-- Category Quick Links -->
    <div class="mb-4">
        <h4>Movie Categories</h4>
        <div class="d-flex flex-wrap gap-2 mt-2">
            @Html.ActionLink("All Movies", "Index", "Movie", null, new { @class = "btn btn-outline-dark btn-sm" })
            @if (categories != null)
            {
                foreach (var cat in categories)
                {
                    <a href="@Url.Action("Index", "Movie", new { searchCatId = cat.Cat_ID })" class="btn btn-outline-primary btn-sm">
                        @cat.Cat_Type
                    </a>
                }
            }
        </div>
    </div>

    <!-- Now Showing Movies -->
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>Now Showing</h4>
            @Html.ActionLink("View All Movies >>", "Index", "Movie", null, new { @class = "text-decoration-none" })
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Movie Name</th>
                            <th>Category</th>
                            <th>Release Date</th>
                            <th>Rate</th>
                            <th style="width: 130px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movie in Model)
                        {
                            <tr>
                                <td><strong>@movie.Movie_name</strong></td>
                                <td>@movie.Cat_Type</td>
                                <td>@movie.Release_Date.ToString("dd-MM-yyyy")</td>
                                <td>₹@movie.rate.ToString("F2")</td>
                                <td>
                                    <a href="@Url.Action("Book", "Booking", new { movieId = movie.Movie_ID, catId = movie.Cat_ID })" class="btn btn-primary btn-sm">
                                        Book Tickets
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No movies available at the moment.</p>
        }
    </div>
</main>