@model OnlineMovieBooking.Models.Movie

@{
    ViewBag.Title = "Delete Movie";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete Movie</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Movie</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Movie ID</dt>
        <dd class="col-sm-10">@Model.Movie_ID</dd>

        <dt class="col-sm-2">Movie Name</dt>
        <dd class="col-sm-10">@Model.Movie_name</dd>

        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.Cat_Type</dd>

        <dt class="col-sm-2">Release Date</dt>
        <dd class="col-sm-10">@Model.Release_Date.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-2">Rate</dt>
        <dd class="col-sm-10">₹@Model.rate.ToString("F2")</dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "Movie", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Movie_ID)

        <input type="submit" value="Delete" class="btn btn-danger" />
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
    }
</div>
