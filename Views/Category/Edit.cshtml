@model OnlineMovieBooking.Models.MovieCategory

@{
    ViewBag.Title = "Edit Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit Category</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>MovieCategory</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.Cat_ID)

        <div class="mb-3">
            <label class="form-label">Cat_ID</label>
            <input type="text" class="form-control" value="@Model.Cat_ID" disabled readonly />
        </div>

        <div class="mb-3">
            @Html.LabelFor(model => model.Cat_Type, htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Cat_Type, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Cat_Type, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <input type="submit" value="Save" class="btn btn-primary" />
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
