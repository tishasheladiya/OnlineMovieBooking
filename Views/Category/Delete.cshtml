@model OnlineMovieBooking.Models.MovieCategory

@{
    ViewBag.Title = "Delete Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete Category</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>MovieCategory</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Cat_ID</dt>
        <dd class="col-sm-10">@Model.Cat_ID</dd>

        <dt class="col-sm-2">Cat_Type</dt>
        <dd class="col-sm-10">@Model.Cat_Type</dd>
    </dl>

    @using (Html.BeginForm("DeleteConfirmed", "Category", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.Cat_ID)

        <input type="submit" value="Delete" class="btn btn-danger" />
        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
    }
</div>
